[2.540482, "o", "\r<venv/bin/python primitive_db-0.4.0-py3-none-any.whl                         \b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\r\r\n"]
[2.622864, "o", "Resolved 4 packages in 1ms\r\r\n"]
[2.625835, "o", "Prepared 1 package in 2ms\r\r\n"]
[2.628568, "o", "Installed 4 packages in 2ms\r\r\n + prettytable"]
[2.628623, "o", "==3.18.0\r\r\n + primitive-db==0.4.0 (from file:///private/tmp/primitive-db-final-demo/primitive_db-0.4.0-py3-none-any.whl)\r\r\n + prompt==0.4.1\r\r\n + wcwidth==0.9.4\r\r\n"]
[2.629933, "o", "$ "]
[5.541992, "o", ".venv/bin/datab"]
[5.542322, "o", "ase\r\r\n"]
[6.013326, "o", "\r\r\n***Операции с данными***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\r\n<command> select from <имя_таблицы> - прочитать все записи\r\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\r\n<command> update <имя_таблицы> set <столбец> = <новое_значение> where <столбец_условия> = <значение_условия> - обновить записи\r\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r"]
[6.013361, "o", "\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\n>>>Введите команду: "]
[7.542958, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[7.543333, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n"]
[7.545839, "o", "\r\r\n>>>Введите команду: "]
[8.547443, "o", "insert into users values (\"Sergei\", 28, true)\r\r\n"]
[8.548733, "o", "Функция insert выполнилась за 0.001 секунд\r\r\n"]
[8.549695, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\r\n"]
[8.549834, "o", "\r\r\n>>>Введите команду: "]
[10.052562, "o", "insert into users values (\"Anna\", \"wrong\", true)\r\r\n"]
[10.052939, "o", "Функция insert выполнилась за 0.000 секунд\r\r\nОшибка валидации: age='wrong': ожидается int\r\r\n"]
[10.053474, "o", "\r\r\n>>>Введите команду: "]
[11.555136, "o", "select from users where age = 28\r\r\n"]
[11.556622, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[11.935987, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[11.936027, "o", "\r\r\n>>>Введите команду: "]
[13.060249, "o", "select from users where age = 28\r\r\n"]
[13.06143, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[13.061796, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[13.062061, "o", "\r\r\n>>>Введите команду: "]
[14.560964, "o", "update users set age = 29 where ID = 1\r\r\n"]
[14.562087, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\r\n"]
[14.562185, "o", "\r\r\n>>>Введите команду: "]
[15.566318, "o", "select from users\r\r\n"]
[15.567203, "o", "Функция select выполнилась за 0.000 секунд\r\r\n"]
[15.567655, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[15.567901, "o", "\r\r\n>>>Введите команду: "]
[17.070327, "o", "delete from users where ID = 1\r\r\n"]
[17.07117, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[18.075522, "o", "n\r\r\nОперация отменена.\r\r\n"]
[18.076057, "o", "\r\r\n>>>Введите команду: "]
[19.580657, "o", "info users\r\r\n"]
[19.581401, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 1\r\r\n"]
[19.581651, "o", "\r\r\n>>>Введите команду: "]
[21.084101, "o", "delete from users where ID = 1\r\r\n"]
[21.084956, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[22.089314, "o", "y\r\r\n"]
[22.090666, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\r\n"]
[22.09097, "o", "\r\r\n>>>Введите команду: "]
[23.594428, "o", "info users\r\r\n"]
[23.595092, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 0\r\r\n"]
[23.595316, "o", "\r\r\n>>>Введите команду: "]
[25.099542, "o", "drop_table users\r\r\n"]
[25.099863, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[26.104717, "o", "n\r\r\n"]
[26.105042, "o", "Операция отменена.\r\r\n"]
[26.10526, "o", "\r\r\n>>>Введите команду: "]
[27.605071, "o", "list_tables\r\r\n"]
[27.605306, "o", "- users\r\r\n"]
[27.605476, "o", "\r\r\n>>>Введите команду: "]
[29.110418, "o", "drop_table users\r\r\n"]
[29.110853, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[30.11315, "o", "y\r\r\n"]
[30.1135, "o", "Таблица \"users\" успешно удалена.\r\r\n"]
[30.115557, "o", "\r\r\n>>>Введите команду: "]
[31.613461, "o", "list_tables\r\r\nТаблиц пока нет.\r\r\n"]
[31.614072, "o", "\r\r\n>>>Введите команду: "]
[32.618543, "o", "exit\r\r\n"]
