[2.541129, "o", "\r<venv/bin/python primitive_db-0.3.0-py3-none-any.whl                         \b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\r\r\n"]
[2.62434, "o", "Resolved 4 packages in 1ms\r\r\n"]
[2.62746, "o", "Prepared 1 package in 2ms\r\r\n"]
[2.63008, "o", "Installed 4 packages in 2ms\r\r\n + "]
[2.63013, "o", "prettytable==3.18.0\r\r\n + primitive-db==0.3.0 (from file:///private/tmp/primitive-db-crud-demo/primitive_db-0.3.0-py3-none-any.whl)\r\r\n + prompt==0.4.1\r\r\n + wcwidth==0.9.4\r\r\n"]
[2.631434, "o", "$ "]
[5.543851, "o", ".venv/bin/database\r\r\n"]
[5.930884, "o", "\r\r\n***Операции с данными***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\r\n<command> select from <имя_таблицы> - прочитать все записи\r\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\r\n<command> update <имя_таблицы> set <столбец> = <новое_значение> where <столбец_условия> = <значение_условия> - обновить записи\r\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r"]
[5.930973, "o", "\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\n>>>Введите команду: "]
[7.548888, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[7.549279, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n"]
[7.552179, "o", "\r\r\n>>>Введите команду: "]
[9.054276, "o", "insert into users values (\"Sergei\", 28, true)\r\r\n"]
[9.056307, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\r\n"]
[9.056564, "o", "\r\r\n>>>Введите команду: "]
[10.555713, "o", "select from users where age = 28\r\r\n"]
[10.972153, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[10.972236, "o", "\r\r\n>>>Введите команду: "]
[12.560894, "o", "update users set age = 29 where name = \"Sergei\"\r\r\n"]
[12.563008, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\r\n"]
[12.563228, "o", "\r\r\n>>>Введите команду: "]
[14.066101, "o", "select from users\r\r\n"]
[14.067752, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n"]
[14.067947, "o", "\r\r\n>>>Введите команду: "]
[16.069834, "o", "info users\r\r\n"]
[16.070393, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 1\r\r\n"]
[16.070558, "o", "\r\r\n>>>Введите команду: "]
[17.574417, "o", "exit\r\r\n"]
[17.594775, "o", "$ "]
[18.579661, "o", ".venv/bin/"]
