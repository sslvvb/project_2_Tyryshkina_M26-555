[5.539553, "o", ".venv/bin/dat"]
[5.539713, "o", "abase\r\r\n"]
[7.544509, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[7.567617, "o", "\r\r\n***Процесс работы с таблицей***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n"]
[7.567677, "o", "\r\r\n>>>Введите команду: "]
[7.567687, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n"]
[7.567871, "o", "\r\r\n>>>Введите команду: "]
[9.049139, "o", "create_table users name:str\r\r\n"]
[9.049245, "o", "Ошибка: Таблица \"users\" уже существует.\r\r\n"]
[9.049669, "o", "\r\r\n>>>Введите команду: "]
[10.549544, "o", "list_tables\r\r\n"]
[10.549704, "o", "- users\r\r\n"]
[10.549847, "o", "\r\r\n>>>Введите команду: "]
[12.051677, "o", "drop_table users\r\r\n"]
[12.051903, "o", "Таблица \"users\" успешно удалена.\r\r\n"]
[12.052943, "o", "\r\r\n>>>Введите команду: "]
[13.552178, "o", "list_tables\r\r\n"]
[13.552345, "o", "Таблиц пока нет.\r\r\n"]
[13.552511, "o", "\r\r\n>>>Введите команду: "]
[15.055118, "o", "drop_table products\r\r\n"]
[15.055174, "o", "Ошибка: Таблица \"products\" не существует.\r\r\n"]
[15.055766, "o", "\r\r\n>>>Введите команду: "]
[16.559008, "o", "help\r\r\n"]
[16.559087, "o", "***Процесс работы с таблицей***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> exit - выход из программы\r\r\n"]
[16.559296, "o", "<command> help - справочная информация\r\r\n"]
[16.559478, "o", "\r\r\n>>>Введите команду: "]
